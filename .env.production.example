APP_NAME=AIA LeadOps Automation
APP_VERSION=1.0.0
APP_ROOT_PATH=/leadops

DATABASE_URL=postgresql+psycopg://leadops:CHANGE_ME@db:5432/leadops
LEADOPS_DB_PASSWORD=CHANGE_ME

DEMO_MODE=true
DEMO_RATE_LIMIT_PER_MINUTE=12
DEMO_DISABLE_EXTERNAL_AI=true
DEMO_DISABLE_EXTERNAL_AUTOMATION=true

AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.1-8b-instant
AI_API_KEY=
AI_TIMEOUT_SECONDS=15

N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
AUTOMATION_TIMEOUT_SECONDS=5
AUTOMATION_MAX_ATTEMPTS=3
AUTOMATION_RETRY_BACKOFF_SECONDS=0.25
